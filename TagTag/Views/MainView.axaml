<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TagTag.ViewModels"
             xmlns:rx="using:ReactiveUI.Avalonia"
             xmlns:l="using:TagTag"
             x:Class="TagTag.Views.MainView"
             x:DataType="vm:MainViewModel"
             x:Name="uc">
  <UserControl.Styles>
    <Style Selector="Button">
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#ffffff"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Padding" Value="3,0"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBlock.ab">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="300"/>
      <Setter Property="Foreground" Value="#787878"/>
    </Style>
    <Style Selector="TextBlock.ib">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#787878"/>
      <Setter Property="Margin" Value="9,0,0,0"/>
    </Style>
    <Style Selector="Separator">
      <Setter Property="Height" Value="12"/>
      <Setter Property="Background">
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <LinearGradientBrush.GradientStops>
            <GradientStop Color="#00232c3b"  Offset="0.4"/>
            <GradientStop Color="#232c3b"  Offset="0.5"/>
            <GradientStop Color="#00232c3b"  Offset="0.6"/>
          </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
      </Setter>
    </Style>
  </UserControl.Styles>
  <rx:RoutedViewHost Grid.Row="0" Router="{Binding Router}">
    <rx:RoutedViewHost.ViewLocator>
      <l:ViewLocator/>
    </rx:RoutedViewHost.ViewLocator>
    <rx:RoutedViewHost.DefaultContent>
      <Grid RowDefinitions="auto,*" Background="#0F1523">
        <Border Grid.Row="0">
          <Panel>
            <Border Background="Transparent" Tapped="Execute_Tag_Command" Tag="{Binding ToggleParentsCommand}" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="7">
              <Panel Margin="5,0">
                <Panel IsVisible="{Binding !AtRoot}">
                  <TextBlock Text="❮" Classes="ab" IsVisible="{Binding NavigateChildren}"/>
                  <TextBlock Text="❯" Classes="ab" IsVisible="{Binding !NavigateChildren}"/>
                </Panel>
                <TextBlock Text="❮" Classes="ab" IsVisible="{Binding AtRoot}" Opacity="0.3"/>
              </Panel>
            </Border>
            <Panel Height="28" ClipToBounds="True">
              <Button Foreground="#aaaaaa" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="18" Content="☁" Padding="3" Command="{Binding Cloud}" Margin="0,0,7,0"/>
              <Button Foreground="#aaaaaa" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="32" Content="+" FontWeight="300" Padding="3" Command="{Binding NewNoteCommand}" Margin="0,-12,40,0"/>
            </Panel>
            <TextBlock Text="Tagless" VerticalAlignment="Center" FontSize="18" FontWeight="500" HorizontalAlignment="Center" IsVisible="{Binding AtRoot}"/>
            <ItemsControl ItemsSource="{Binding CurrentTags}" HorizontalAlignment="Center">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:NavBarViewModel">
                  <Border Margin="3" Padding="5" Background="#001B2732" Tapped="Execute_Tag_Command" Tag="{Binding NavigateCommand}" CornerRadius="7">
                    <Panel>
                      <TextBlock Text="{Binding TagVM.Name}" VerticalAlignment="Center" FontSize="18" FontWeight="500"/>
                      <Ellipse Width="3" Height="3" IsVisible="{Binding !IsFirst}" Fill="#787878" HorizontalAlignment="Left" Margin="-10,0,0,0"/>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Panel>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel Margin="15,0">
            <ItemsControl ItemsSource="{Binding ParentTags}" IsVisible="{Binding !NavigateChildren}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Tapped="Execute_Tag_Command" Tag="{Binding NavigateCommand}" Background="Transparent">
                      <Grid ColumnDefinitions="auto,auto,*" ColumnSpacing="7" RowSpacing="5" Margin="0,7">
                        <Separator IsVisible="{Binding !IsFirst}" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-14,0,0"/>
                        <TextBlock Grid.Column="0" Text="❮" Classes="ab" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="🔖" Classes="ib" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding TagVM.Name, FallbackValue='home'}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                      </Grid>
                    </Border>
                </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding NextTags}" IsVisible="{Binding NavigateChildren}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Tapped="Execute_Tag_Command" Tag="{Binding NavigateCommand}"  Background="Transparent">
                      <Grid ColumnDefinitions="auto,*,auto" ColumnSpacing="7" RowSpacing="5" Margin="0,7">
                        <Separator IsVisible="{Binding !IsFirst}" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="0,-14,0,0"/>
                        <TextBlock Grid.Column="0" Text="🔖" Classes="ib" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TagVM.Name}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Grid.Column="2" Text="❯" Classes="ab" Margin="0,0,9,0" VerticalAlignment="Center"/>
                      </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding DetailItems}" BorderBrush="#232c3b" BorderThickness="0,0,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Height="81" Background="Transparent" Tapped="Execute_Tag_Command" Tag="{Binding #uc.DataContext.NavigateCommand}">
                      <Grid RowDefinitions="auto,*" ColumnDefinitions="auto,*,auto" ColumnSpacing="7" RowSpacing="5" Margin="9">
                        <Separator IsVisible="{Binding !IsFirst}" Grid.ColumnSpan="3" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="-9,-14,-9,0"/>
                        <TextBlock Grid.Column="0" Text="🗎" Classes="ib" VerticalAlignment="Center" Margin="0"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Margin="0,0,0,2"/>
                        <TextBlock Grid.Row="0"  FontSize="12" Grid.Column="2" VerticalAlignment="Center" Text="{Binding Date}" Foreground="#787878" />
                        <TextBlock Grid.ColumnSpan="3" MaxHeight="200" FontWeight="ExtraLight" Margin="0,2,0,0" Grid.Row="1" Text="{Binding Text}" />
                        <TextBlock Grid.ColumnSpan="3" MaxHeight="200" FontWeight="ExtraLight" Margin="0,2,0,0" Grid.Row="1" Text="empty" Opacity="0.3" IsVisible="{Binding !HasText}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
        </ScrollViewer>
      </Grid>
    </rx:RoutedViewHost.DefaultContent>
  </rx:RoutedViewHost>  
</UserControl>
